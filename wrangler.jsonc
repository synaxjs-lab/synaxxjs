{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "synax-share-easy",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-18",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/signal/*", "/health"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "SignalRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SignalRoom"] }
  ],
  "observability": { "enabled": true }
}
